{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CardModel",
  "type": "object",
  "required": ["id", "pan", "bin", "cardholderName", "status", "currencyCode", "dailyLimit", "monthlyLimit", "availableBalance"],
  "properties": {
    "id": {
      "type": "string"
    },
    "pan": {
      "type": "string",
      "pattern": "^[0-9]{16}$"
    },
    "bin": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "cardholderName": {
      "type": "string"
    },
    "expiryDate": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "INACTIVE", "BLOCKED", "EXPIRED", "DELETED"]
    },
    "currencyCode": {
      "type": "string"
    },
    "dailyLimit": {
      "type": "number"
    },
    "monthlyLimit": {
      "type": "number"
    },
    "availableBalance": {
      "type": "number"
    },
    "issuerId": {
      "type": ["string", "null"]
    },
    "createdAt": {
      "type": "string"
    }
  }
}
